{
  "description": "Healthcare dataset schema with table and column descriptions. This dataset contains synthetic healthcare data including patients, encounters, conditions, medications, claims, and more. Based on Synthea patient generator format.",
  "database": "HealthCare",
  "schema": "public",
  "tables": [
    {
      "name": "patients",
      "description": "Demographic and personal information of patients including birth date, death date, SSN, names, address, race, ethnicity, gender, and healthcare financial data.",
      "rowCount": "varies",
      "columns": [
        {"name": "Id", "description": "Unique identifier for the patient (UUID)", "dataType": "uuid", "primaryKey": true},
        {"name": "BIRTHDATE", "description": "Patient's date of birth", "dataType": "date"},
        {"name": "DEATHDATE", "description": "Patient's date of death (if deceased)", "dataType": "date", "nullable": true},
        {"name": "SSN", "description": "Social Security Number", "dataType": "text"},
        {"name": "DRIVERS", "description": "Driver's license number", "dataType": "text", "nullable": true},
        {"name": "PASSPORT", "description": "Passport number", "dataType": "text", "nullable": true},
        {"name": "PREFIX", "description": "Name prefix (Mr., Ms., Mrs., etc.)", "dataType": "text", "nullable": true},
        {"name": "FIRST", "description": "Patient's first name", "dataType": "text"},
        {"name": "MIDDLE", "description": "Patient's middle name", "dataType": "text", "nullable": true},
        {"name": "LAST", "description": "Patient's last name", "dataType": "text"},
        {"name": "SUFFIX", "description": "Name suffix (Jr., Sr., etc.)", "dataType": "text", "nullable": true},
        {"name": "MAIDEN", "description": "Mother's maiden name (for females)", "dataType": "text", "nullable": true},
        {"name": "MARITAL", "description": "Marital status (M=Married, S=Single, D=Divorced, W=Widowed)", "dataType": "text", "nullable": true},
        {"name": "RACE", "description": "Patient's race (white, black, asian, etc.)", "dataType": "text"},
        {"name": "ETHNICITY", "description": "Patient's ethnicity (hispanic, nonhispanic)", "dataType": "text"},
        {"name": "GENDER", "description": "Patient's gender (M=Male, F=Female)", "dataType": "text"},
        {"name": "BIRTHPLACE", "description": "Place of birth (City, State, Country)", "dataType": "text"},
        {"name": "ADDRESS", "description": "Patient's street address", "dataType": "text"},
        {"name": "CITY", "description": "City of residence", "dataType": "text"},
        {"name": "STATE", "description": "State of residence", "dataType": "text"},
        {"name": "COUNTY", "description": "County of residence", "dataType": "text"},
        {"name": "FIPS", "description": "FIPS county code", "dataType": "integer", "nullable": true},
        {"name": "ZIP", "description": "ZIP/Postal code", "dataType": "text"},
        {"name": "LAT", "description": "Latitude coordinate of address", "dataType": "numeric"},
        {"name": "LON", "description": "Longitude coordinate of address", "dataType": "numeric"},
        {"name": "HEALTHCARE_EXPENSES", "description": "Total healthcare expenses in USD", "dataType": "numeric"},
        {"name": "HEALTHCARE_COVERAGE", "description": "Total healthcare coverage amount in USD", "dataType": "numeric"},
        {"name": "INCOME", "description": "Patient's annual income in USD", "dataType": "numeric"}
      ]
    },
    {
      "name": "encounters",
