        {"name": "REASONCODE", "description": "SNOMED-CT code for encounter reason", "dataType": "text", "nullable": true},
        {"name": "REASONDESCRIPTION", "description": "Description of encounter reason", "dataType": "text", "nullable": true}
      ]
    },
    {
