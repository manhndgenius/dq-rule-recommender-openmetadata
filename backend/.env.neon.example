# OpenMetadata Connection
OM_API=https://your-openmetadata-server.com
BOT_TOKEN=your-openmetadata-bot-jwt-token-here

# LLM Provider (DeepSeek or OpenAI compatible)
LLM_API=your-llm-api-key-here
LLM_MODEL=deepseek-v3
LLM_BASE_URL=https://api.deepseek.com

# Neon PostgreSQL persistence database
# Copy the individual values from Neon Console > Connect.
# A pooled hostname usually contains "-pooler" and is suitable for app traffic.
POSTGRES_HOST=ep-your-endpoint-pooler.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=your_database_owner
POSTGRES_PASSWORD=replace-with-your-neon-password
POSTGRES_DB=neondb
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=10

# Application Environment
APP_ENV=development
