# OpenMetadata Connection
OM_API=https://your-openmetadata-server.com
OM_TOKEN=your-jwt-token-here

# LLM Provider (DeepSeek or OpenAI compatible)
LLM_API=your-llm-api-key-here
LLM_MODEL=deepseek-v3
LLM_BASE_URL=https://api.deepseek.com

# PostgreSQL Database (matches docker-compose.local-db.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=dq_rules
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=dq_rules
POSTGRES_CONNECT_TIMEOUT=5

# Application Environment
APP_ENV=development
